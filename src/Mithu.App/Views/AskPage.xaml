<UserControl x:Class="Mithu.App.Views.AskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Mithu.App"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Mithu.App.Controls"
             xmlns:vm="clr-namespace:Mithu.App.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignWidth="392" d:DesignHeight="284">

    <!--
        Ask page: the conversation with the AI (saved), a message box with Send / Stop, and the chat list
        (search, rename, delete, delete all). New chat starts fresh; the old one stays in the list.
    -->
    <UserControl.Resources>
        <!-- Bubble widths: grow with the panel (set in code from the page width; these are the 1× sizes). -->
        <sys:Double x:Key="BubbleMax">350</sys:Double>
        <sys:Double x:Key="UserBubbleMax">320</sys:Double>
        <sys:Double x:Key="BubbleTextMax">310</sys:Double>
        <sys:Double x:Key="CardMax">360</sys:Double>
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- A chat in the list. DataContext = ChatListItem. -->
        <Style x:Key="ChatCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource MithuFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{StaticResource CardBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource CardRimBrush}" BorderThickness="1" Padding="12,8,6,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "Mithu is thinking…" dots -->
        <Storyboard x:Key="Dots" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.45" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.45" AutoReverse="True" BeginTime="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.45" AutoReverse="True" BeginTime="0:0:0.3" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- nav -->
            <RowDefinition Height="*" />     <!-- conversation / chat list -->
            <RowDefinition Height="Auto" />  <!-- message box -->
        </Grid.RowDefinitions>

        <!-- ← Title ............ chats · New -->
        <Grid Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IslandIconButton}" Content="&#xE72B;"
                    Command="{Binding GoBackCommand}" ToolTip="Back  (Esc)" AutomationProperties.Name="Back" />
            <TextBlock Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource DisplayFont}"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="controls:EmojiText.Text" Value="{Binding Ask.ChatTitle}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Ask.ShowChatList}" Value="True">
                                <Setter Property="controls:EmojiText.Text" Value="Chats" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="&#xE8BD;" Margin="0,0,6,0" Command="{Binding Ask.ToggleChatListCommand}"
                        ToolTip="Your chats" AutomationProperties.Name="Your chats">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IslandIconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Ask.ShowChatList}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                                    <Setter Property="Background" Value="{StaticResource CyanSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource IslandPillButton}" Command="{Binding Ask.NewChatCommand}" AutomationProperties.Name="New chat">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon Glyph="&#xE710;" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="New" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Conversation ===== -->
        <Grid Grid.Row="1" Margin="0,6,0,6"
              Visibility="{Binding Ask.ShowChatList, Converter={StaticResource HideWhen}, ConverterParameter=True}">
            <ScrollViewer x:Name="ConversationScroller" VerticalScrollBarVisibility="Auto" Focusable="False">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                </ScrollViewer.Resources>
                <StackPanel Margin="0,0,6,0">
                    <ItemsControl ItemsSource="{Binding Ask.Bubbles}" Focusable="False" AutomationProperties.Name="Conversation">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatBubble}">
                                <Grid Margin="0,0,0,8">
                                    <!-- You: right, soft cyan -->
                                    <Border HorizontalAlignment="Right" MaxWidth="{DynamicResource UserBubbleMax}" Padding="12,8" CornerRadius="14,14,4,14"
                                            Background="{StaticResource CyanSoftBrush}"
                                            Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <!-- The screenshot sent with it: click to open it full size -->
                                            <Button Click="OpenImage_Click" Cursor="Hand" Margin="-4,-2,-4,6" HorizontalAlignment="Right"
                                                    ToolTip="Open the screenshot" AutomationProperties.Name="Open the screenshot"
                                                    FocusVisualStyle="{StaticResource MithuFocusVisual}"
                                                    Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="9" BorderBrush="{StaticResource CardRimBrush}" BorderThickness="1"
                                                                ClipToBounds="True">
                                                            <Image Source="{Binding Image}" MaxHeight="120" MaxWidth="290" Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBlock controls:EmojiText.Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" LineHeight="19"
                                                       Foreground="{StaticResource TextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Mithu: left, card; a copy button appears beside it on hover -->
                                    <Grid x:Name="MithuRow" HorizontalAlignment="Left" Background="Transparent"
                                          Visibility="{Binding IsMithu, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border MaxWidth="{DynamicResource BubbleMax}" Padding="12,8" CornerRadius="14,14,14,4"
                                                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardRimBrush}" BorderThickness="1"
                                                MouseRightButtonUp="Bubble_RightClick">
                                            <TextBlock controls:ChatMarkdown.Text="{Binding Text}" controls:ChatMarkdown.Caret="{Binding IsStreaming}" TextWrapping="Wrap" FontSize="13" LineHeight="19"
                                                       Foreground="{StaticResource TextBrush}" />
                                        </Border>
                                        <Button Grid.Column="1" Content="&#xE8C8;" Width="26" Height="26" FontSize="11" Margin="4,0,0,0"
                                                VerticalAlignment="Bottom" Click="CopyReply_Click" ToolTip="Copy"
                                                AutomationProperties.Name="Copy reply">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IslandIconButton}">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=MithuRow}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                    <!-- Error: left, amber, with Retry -->
                                    <Border HorizontalAlignment="Left" MaxWidth="{DynamicResource BubbleMax}" Padding="12,8,8,8" CornerRadius="14,14,14,4"
                                            Background="{StaticResource WarningSoftBrush}"
                                            Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock controls:EmojiText.Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18"
                                                       Foreground="{StaticResource WarningBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Style="{StaticResource IslandGhostPillButton}" Content="Try again" Height="26"
                                                        Command="{Binding DataContext.Ask.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        AutomationProperties.Name="Try again" />
                                                <Button Style="{StaticResource IslandGhostPillButton}" Content="{Binding FallbackLabel}" Height="26"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding DataContext.Ask.DoWithoutAiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding FallbackLabel}"
                                                        Visibility="{Binding HasFallback, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- Action: what Mithu did (green check) -->
                                    <Border HorizontalAlignment="Left" MaxWidth="{DynamicResource BubbleMax}" Padding="10,5,12,5" CornerRadius="12"
                                            Background="#1A68E7B1" BorderBrush="#3368E7B1" BorderThickness="1"
                                            AutomationProperties.Name="{Binding Text}"
                                            Visibility="{Binding IsAction, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Glyph="&#xE73E;" FontSize="11"
                                                           Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,1,8,0" />
                                                <TextBlock controls:EmojiText.Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" MaxWidth="{DynamicResource BubbleTextMax}"
                                                           Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- The screenshot Mithu took: click to open it full size -->
                                            <Button Click="OpenImage_Click" Cursor="Hand" Margin="0,6,0,1" HorizontalAlignment="Left"
                                                    ToolTip="Open the screenshot" AutomationProperties.Name="Open the screenshot Mithu took"
                                                    FocusVisualStyle="{StaticResource MithuFocusVisual}"
                                                    Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="8" BorderBrush="#3368E7B1" BorderThickness="1" ClipToBounds="True">
                                                            <Image Source="{Binding Image}" MaxHeight="90" MaxWidth="240" Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <!-- Execution card: what Mithu does on the PC, step by step -->
                                    <Border HorizontalAlignment="Stretch" MaxWidth="{DynamicResource CardMax}" Margin="0,0,24,0" CornerRadius="14,14,14,4"
                                            Background="{StaticResource CardBrush}" BorderThickness="1" DataContext="{Binding Card}"
                                            AutomationProperties.Name="{Binding Title, StringFormat=Actions: {0}}"
                                            Visibility="{Binding DataContext.IsCard, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource CardRimBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <!-- Folded: one line (tap to open) with Undo -->
                                            <Grid Margin="10,7,6,7" Visibility="{Binding ShowSteps, Converter={StaticResource HideWhen}, ConverterParameter=True}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls:Icon Glyph="{Binding SummaryGlyph}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <controls:Icon.Style>
                                                        <Style TargetType="controls:Icon">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SummaryIsWarning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsUndone}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </controls:Icon.Style>
                                                </controls:Icon>
                                                <TextBlock Grid.Column="1" controls:EmojiText.Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Style="{StaticResource IslandGhostPillButton}" Height="24" Padding="9,0" Margin="6,0,0,0" FontSize="11.5"
                                                        Command="{Binding DataContext.Ask.UndoCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="Undo"
                                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:Icon Glyph="&#xE7A7;" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <TextBlock Text="Undo" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="3" Style="{StaticResource IslandIconButton}" Content="&#xE70D;" Width="24" Height="24" FontSize="9" Margin="2,0,0,0"
                                                        Command="{Binding DataContext.Ask.ToggleCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="Show the steps" AutomationProperties.Name="Show the steps"
                                                        Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>

                                            <!-- Open: header, steps, Stop / Undo -->
                                            <StackPanel Visibility="{Binding ShowSteps, Converter={StaticResource BoolToVisibility}}">
                                                <Grid Margin="12,9,6,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <controls:Icon Glyph="&#xE945;" FontSize="11" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" controls:EmojiText.Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Progress}" Style="{StaticResource CaptionText}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"
                                                               Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Grid.Column="3" Style="{StaticResource IslandIconButton}" Content="&#xE70E;" Width="24" Height="24" FontSize="9"
                                                            Command="{Binding DataContext.Ask.ToggleCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Fold" AutomationProperties.Name="Fold the steps"
                                                            Visibility="{Binding IsWorking, Converter={StaticResource HideWhen}, ConverterParameter=True}" />
                                                </Grid>
                                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="12,0" />
                                                <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" Margin="12,6,10,4" AutomationProperties.Name="Steps">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:CardStep}">
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <controls:Icon Glyph="{Binding Glyph}" FontSize="11" VerticalAlignment="Top" Margin="0,2,9,0" RenderTransformOrigin="0.5,0.5">
                                                                    <controls:Icon.RenderTransform>
                                                                        <RotateTransform />
                                                                    </controls:Icon.RenderTransform>
                                                                    <controls:Icon.Style>
                                                                        <Style TargetType="controls:Icon">
                                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                                                                                    <DataTrigger.EnterActions>
                                                                                        <BeginStoryboard x:Name="Spin">
                                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                                                 From="0" To="360" Duration="0:0:0.9" />
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </DataTrigger.EnterActions>
                                                                                    <DataTrigger.ExitActions>
                                                                                        <StopStoryboard BeginStoryboardName="Spin" />
                                                                                    </DataTrigger.ExitActions>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </controls:Icon.Style>
                                                                </controls:Icon>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock controls:EmojiText.Text="{Binding Text}" FontSize="12" TextWrapping="Wrap">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,2"
                                                                                Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}">
                                                                        <Button Style="{StaticResource IslandGhostPillButton}" Content="Cancel" Height="28" Padding="14,0"
                                                                                Command="{Binding DataContext.Ask.DeclineStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}" AutomationProperties.Name="Cancel this step" />
                                                                        <Button Style="{StaticResource IslandPillButton}" Content="Approve" Height="28" Padding="14,0" Margin="6,0,0,0"
                                                                                Command="{Binding DataContext.Ask.ApproveStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}" AutomationProperties.Name="Approve this step" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,8,9">
                                                    <Button Style="{StaticResource IslandGhostPillButton}" Height="26" Padding="12,0"
                                                            Command="{Binding DataContext.Ask.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            AutomationProperties.Name="Stop"
                                                            Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:Icon Glyph="&#xE71A;" FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                            <TextBlock Text="Stop" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource IslandGhostPillButton}" Height="26" Padding="12,0" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.Ask.UndoCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" AutomationProperties.Name="Undo all"
                                                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:Icon Glyph="&#xE7A7;" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                            <TextBlock Text="Undo" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Approval: Mithu asks before an action (only the user's click answers) -->
                                    <Border HorizontalAlignment="Left" MaxWidth="{DynamicResource BubbleMax}" Padding="12,9,10,9" CornerRadius="14,14,14,4"
                                            Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1"
                                            AutomationProperties.Name="{Binding Text}"
                                            Visibility="{Binding IsApproval, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Glyph="&#xE945;" FontSize="12" Foreground="{StaticResource CyanBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock controls:EmojiText.Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" MaxWidth="{DynamicResource BubbleTextMax}"
                                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"
                                                        Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                                                <Button Style="{StaticResource IslandGhostPillButton}" Content="Cancel" Height="28" Padding="14,0"
                                                        Command="{Binding DataContext.Ask.DeclineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="Cancel this action" />
                                                <Button Style="{StaticResource IslandPillButton}" Content="Approve" Height="28" Padding="14,0" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.Ask.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="Approve this action" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Answer}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                       Visibility="{Binding IsPending, Converter={StaticResource HideWhen}, ConverterParameter=True}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Note: centred -->
                                    <TextBlock controls:EmojiText.Text="{Binding Text}" HorizontalAlignment="Center" Style="{StaticResource CaptionText}"
                                               Visibility="{Binding IsNote, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Mithu is thinking… -->
                    <Border x:Name="Thinking" HorizontalAlignment="Left" Padding="14,10" CornerRadius="14,14,14,4" Margin="0,0,0,8"
                            Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardRimBrush}" BorderThickness="1"
                            AutomationProperties.Name="Mithu is thinking"
                            Visibility="{Binding Ask.ShowThinking, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Dot1" Width="6" Height="6" Fill="{StaticResource CyanBrush}" Margin="0,0,4,0" />
                            <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="{StaticResource CyanBrush}" Margin="0,0,4,0" />
                            <Ellipse x:Name="Dot3" Width="6" Height="6" Fill="{StaticResource CyanBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Empty: what this is (or how to turn it on) -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300"
                        Visibility="{Binding Ask.HasBubbles, Converter={StaticResource HideWhen}, ConverterParameter=True}">
                <controls:Icon Glyph="&#xE8BD;" FontSize="22"
                           Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Ask me anything" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Style="{StaticResource CaptionText}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Plans, quick answers, ideas. Chats are saved on this PC." />
                <Button Style="{StaticResource IslandPillButton}" Content="Set up AI" Margin="0,12,0,0" HorizontalAlignment="Center"
                        Command="{Binding OpenAiSettingsCommand}" AutomationProperties.Name="Set up AI"
                        Visibility="{Binding Ask.IsReady, Converter={StaticResource HideWhen}, ConverterParameter=True}" />
            </StackPanel>
        </Grid>

        <!-- ===== Chat list ===== -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Margin="0,6,0,0"
              Visibility="{Binding Ask.ShowChatList, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Height="32" CornerRadius="16" Padding="12,0" Background="{StaticResource InputBrush}"
                    BorderBrush="{StaticResource CardRimBrush}" BorderThickness="1">
                <Grid>
                    <TextBox x:Name="ChatSearchBox" Style="{StaticResource IslandInput}" FontSize="12.5" VerticalAlignment="Center"
                             Text="{Binding Ask.ChatSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search chats" />
                    <TextBlock Text="Search your chats" FontSize="12.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=ChatSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding Ask.Chats}" Focusable="False" Margin="0,0,6,0" AutomationProperties.Name="Chats">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatListItem}">
                                <Button Style="{StaticResource ChatCard}" AutomationProperties.Name="{Binding Title}"
                                        Command="{Binding DataContext.Ask.OpenChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" MouseRightButtonUp="ChatCard_RightClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock controls:EmojiText.Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource IslandIconButton}" Content="&#xE712;" Width="28" Height="28"
                                                Click="ChatMenu_Click" ToolTip="More" AutomationProperties.Name="More actions" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding Ask.ChatsEmptyText}" Style="{StaticResource CaptionText}" FontSize="12.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Ask.HasChats, Converter={StaticResource HideWhen}, ConverterParameter=True}" />
            </Grid>

            <Button Grid.Row="2" Height="30" Padding="14,0" Margin="0,8,0,2" HorizontalAlignment="Center"
                    Command="{Binding Ask.DeleteAllCommand}" AutomationProperties.Name="Delete all chats"
                    Visibility="{Binding Ask.HasChats, Converter={StaticResource BoolToVisibility}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource IslandGhostPillButton}">
                        <Setter Property="Content" Value="{Binding Ask.DeleteAllText}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Ask.ConfirmDeleteAll}" Value="True">
                                <Setter Property="Background" Value="{StaticResource UrgentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource UrgentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- ===== Message box (with a screenshot waiting to be sent) ===== -->
        <StackPanel Grid.Row="2"
                    Visibility="{Binding Ask.ShowChatList, Converter={StaticResource HideWhen}, ConverterParameter=True}">
            <Border Margin="0,0,0,6" Padding="6" CornerRadius="14" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardRimBrush}" BorderThickness="1"
                    AutomationProperties.Name="Attached screenshot"
                    Visibility="{Binding Ask.HasAttachment, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Preview with ✕ -->
                    <Grid VerticalAlignment="Top">
                        <Border CornerRadius="8" ClipToBounds="True" BorderBrush="{StaticResource CardRimBrush}" BorderThickness="1">
                            <Image Source="{Binding Ask.AttachmentPreview}" MaxHeight="64" MaxWidth="104" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <Button Style="{StaticResource IslandIconButton}" Content="&#xE711;" Width="20" Height="20" FontSize="8"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                Background="{StaticResource MenuSurfaceBrush}"
                                Command="{Binding Ask.RemoveAttachmentCommand}" ToolTip="Remove the screenshot"
                                AutomationProperties.Name="Remove the screenshot" />
                    </Grid>
                    <!-- Quick questions (need AI) and Copy text (works on this PC, no AI) -->
                    <WrapPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Source={x:Static vm:AskViewModel.ScreenshotChips}}" Focusable="False"
                                      Visibility="{Binding Ask.ShowScreenshotChips, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ScreenshotChip}">
                                    <Button Style="{StaticResource IslandGhostPillButton}" Content="{Binding Label}" Height="24"
                                            Padding="10,0" Margin="0,0,4,4" FontSize="11.5" ToolTip="{Binding Prompt}"
                                            AutomationProperties.Name="{Binding Label}"
                                            Command="{Binding DataContext.Ask.QuickAskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource IslandGhostPillButton}" Height="24" Padding="10,0" Margin="0,0,4,4" FontSize="11.5"
                                Command="{Binding Ask.CopyTextCommand}" AutomationProperties.Name="Copy text"
                                ToolTip="Read the text in the screenshot on this PC and copy it (no AI)">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Glyph="&#xE8C8;" FontSize="10"
                                           VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Copy text" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ask.IsReadingText}" Value="True">
                                                    <Setter Property="Text" Value="Reading…" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IslandGhostPillButton}" Height="24" Padding="10,0" Margin="0,0,4,4" FontSize="11.5"
                                Command="{Binding Ask.GoogleLensCommand}" AutomationProperties.Name="Google Lens"
                                ToolTip="Copy the screenshot and open Google Lens, then paste it there (Ctrl+V). It goes to Google only when you paste.">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Glyph="&#xE721;" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="Google Lens" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

        <Border x:Name="InputPill" MinHeight="40" CornerRadius="20" Padding="14,4,4,4"
                Background="{StaticResource InputBrush}" BorderBrush="{StaticResource CardRimBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MessageBox" Style="{StaticResource IslandInput}" FontSize="13.5"
                         Text="{Binding Ask.Draft, UpdateSourceTrigger=PropertyChanged}" MaxLength="8000"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="76" VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="MessageBox_PreviewKeyDown"
                         AutomationProperties.Name="Message to Mithu" />
                <TextBlock FontSize="13.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Text" Value="{Binding Path=(app:Companion.Name), StringFormat='Message {0}…'}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Ask.HasAttachment}" Value="True">
                                    <Setter Property="Text" Value="Ask about the screenshot…" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=MessageBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Screenshot & ask: pick part of the screen to ask about -->
                <Button Grid.Column="1" Style="{StaticResource IslandIconButton}" Content="{StaticResource ScreenshotAskIcon}"
                        Width="32" Height="32" VerticalAlignment="Bottom" Margin="6,0,0,0" Command="{Binding Ask.CaptureCommand}"
                        ToolTip="Screenshot &amp; ask: pick an area, a window or the whole screen  (Ctrl+Shift+S)"
                        AutomationProperties.Name="Take a screenshot" />
                <Button Grid.Column="2" Style="{StaticResource IslandPrimaryButton}" Content="&#xE724;" VerticalAlignment="Bottom"
                        Margin="6,0,0,0" Command="{Binding Ask.SendCommand}" ToolTip="Send  (Enter · Shift+Enter for a new line)"
                        AutomationProperties.Name="Send"
                        Visibility="{Binding Ask.IsBusy, Converter={StaticResource HideWhen}, ConverterParameter=True}" />
                <Button Grid.Column="2" Style="{StaticResource IslandPrimaryButton}" Content="&#xE71A;" VerticalAlignment="Bottom"
                        Margin="6,0,0,0" Command="{Binding Ask.StopCommand}" ToolTip="Stop" AutomationProperties.Name="Stop"
                        Visibility="{Binding Ask.IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
        </StackPanel>
    </Grid>
</UserControl>