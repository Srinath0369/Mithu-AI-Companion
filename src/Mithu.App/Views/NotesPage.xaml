<UserControl x:Class="Mithu.App.Views.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Mithu.App.Controls"
             xmlns:vm="clr-namespace:Mithu.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignWidth="392" d:DesignHeight="284">

    <!--
        Notes page inside the expanded panel: a list (search, tags, sort, pinned first) and an editor
        (title, tags, formatting toolbar, autosave, formatted view with tickable checklists).
    -->
    <UserControl.Resources>
        <!-- Tag filter chip; the selected one glows cyan. DataContext = TagFilter. -->
        <Style x:Key="TagChip" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource MithuFocusVisual}" />
            <Setter Property="Command" Value="{Binding SelectCommand}" />
            <Setter Property="Content" Value="{Binding Label}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CyanSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A note in the list: a whole-card button (keyboard friendly). DataContext = NoteItem. -->
        <Style x:Key="NoteCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource MithuFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{StaticResource CardBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource CardRimBrush}" BorderThickness="1" Padding="12,8,6,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar buttons (B, I, H, •, ☐). Not focusable: clicking them keeps the cursor and selection in the note. -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource IslandIconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="NavTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="38,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        </Style>

        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ================================================================ -->
        <!-- ===== List ====================================================== -->
        <!-- ================================================================ -->
        <Grid x:Name="ListView"
              Visibility="{Binding Notes.IsEditing, Converter={StaticResource HideWhen}, ConverterParameter=True}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- nav -->
                <RowDefinition Height="Auto" />  <!-- search -->
                <RowDefinition Height="Auto" />  <!-- tags + sort -->
                <RowDefinition Height="*" />     <!-- notes -->
            </Grid.RowDefinitions>

            <!-- ← Notes ............ + New -->
            <Grid Height="32">
                <Button Style="{StaticResource IslandIconButton}" Content="&#xE72B;" HorizontalAlignment="Left"
                        Command="{Binding GoBackCommand}" ToolTip="Back  (Esc)" AutomationProperties.Name="Back" />
                <TextBlock Text="{Binding Notes.ListTitle}" Style="{StaticResource NavTitle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding Notes.CanCreate, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource IslandIconButton}" Content="&#xE7B8;" Margin="0,0,6,0"
                            Command="{Binding Notes.ToggleArchivedCommand}" ToolTip="Archived notes"
                            AutomationProperties.Name="Archived notes" />
                    <Button Style="{StaticResource IslandPillButton}"
                            Command="{Binding Notes.NewNoteCommand}" AutomationProperties.Name="New note">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Glyph="&#xE710;" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="New" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Search -->
            <Border Grid.Row="1" Margin="0,8,0,0" Height="34" CornerRadius="17" Padding="12,0,4,0"
                    Background="{StaticResource InputBrush}" BorderBrush="{StaticResource CardRimBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:Icon Glyph="&#xE721;" FontSize="12"
                               Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource IslandInput}" FontSize="13"
                             Text="{Binding Notes.Search, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search notes" />
                    <TextBlock Grid.Column="1" Text="Search notes and #tags" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2" Style="{StaticResource IslandIconButton}" Content="&#xE711;" Width="26" Height="26"
                            FontSize="10" Command="{Binding Notes.ClearSearchCommand}" ToolTip="Clear search"
                            AutomationProperties.Name="Clear search"
                            Visibility="{Binding Notes.HasSearch, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <!-- Tag chips (scroll sideways) + sort -->
            <Grid Grid.Row="2" Margin="0,8,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="TagScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              Visibility="{Binding Notes.HasTags, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Notes.Tags}" Focusable="False" AutomationProperties.Name="Filter by tag">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TagChip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button x:Name="SortButton" Grid.Column="1" Style="{StaticResource IslandGhostPillButton}" Height="24"
                        Padding="10,0" FontSize="11.5" Margin="6,0,0,0" Click="SortButton_Click"
                        ToolTip="Sort notes" AutomationProperties.Name="Sort notes">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon Glyph="&#xE8CB;" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Notes.SortText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- The notes -->
            <Grid Grid.Row="3">
                <ScrollViewer x:Name="NoteScroller" VerticalScrollBarVisibility="Hidden" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Notes.Items}" Focusable="False" AutomationProperties.Name="Notes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NoteItem}">
                                <Button Style="{StaticResource NoteCard}"
                                        Command="{Binding DataContext.Notes.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Title}"
                                        MouseRightButtonUp="NoteCard_RightClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <controls:Icon Glyph="&#xE718;"
                                                           FontSize="11" Foreground="{StaticResource CyanBrush}"
                                                           VerticalAlignment="Center" Margin="0,1,6,0"
                                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}"
                                                           AutomationProperties.Name="Pinned" />
                                                <TextBlock controls:EmojiText.Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                           MaxWidth="300" />
                                            </StackPanel>
                                            <TextBlock controls:EmojiText.Text="{Binding Preview}" Style="{StaticResource CaptionText}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                       Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding TagsText}" FontSize="11" Foreground="{StaticResource CyanBrush}"
                                                           Opacity="0.85" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" MaxWidth="220"
                                                           Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding When}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource IslandIconButton}" Content="&#xE712;"
                                                Width="26" Height="26" VerticalAlignment="Top" Click="NoteMenu_Click"
                                                ToolTip="More" AutomationProperties.Name="More actions" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{Binding Notes.EmptyText}" Style="{StaticResource CaptionText}" FontSize="12.5"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="20"
                           Visibility="{Binding Notes.HasNotes, Converter={StaticResource HideWhen}, ConverterParameter=True}" />

                <!-- Undo bar after a delete -->
                <Border VerticalAlignment="Bottom" Margin="0,0,0,2" Padding="14,4,4,4" CornerRadius="16"
                        Background="{StaticResource MenuSurfaceBrush}" BorderBrush="{StaticResource IslandRimBrush}" BorderThickness="1"
                        Visibility="{Binding Notes.CanUndo, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock Text="{Binding Notes.UndoText}" Foreground="{StaticResource TextBrush}" FontSize="12.5" VerticalAlignment="Center" />
                        <Button Style="{StaticResource IslandPillButton}" Content="Undo" HorizontalAlignment="Right" Height="26"
                                Command="{Binding Notes.UndoCommand}" AutomationProperties.Name="Undo" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================================================================ -->
        <!-- ===== Editor ==================================================== -->
        <!-- ================================================================ -->
        <Grid x:Name="EditorView"
              Visibility="{Binding Notes.IsEditing, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- back · title · actions -->
                <RowDefinition Height="Auto" />  <!-- tags -->
                <RowDefinition Height="Auto" />  <!-- toolbar -->
                <RowDefinition Height="*" />     <!-- body -->
            </Grid.RowDefinitions>

            <!-- ← Title ........ pin copy ⋯  (the title lives in the top bar to give the note more room) -->
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IslandIconButton}" Content="&#xE72B;"
                        Command="{Binding GoBackCommand}" ToolTip="Back to notes  (Esc)" AutomationProperties.Name="Back to notes" />
                <Grid Grid.Column="1" Margin="8,0,6,0">
                    <TextBox x:Name="TitleBox" Style="{StaticResource IslandInput}" FontSize="15" FontWeight="SemiBold"
                             FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center"
                             Text="{Binding Notes.Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                             AutomationProperties.Name="Note title" />
                    <TextBlock Text="Title" FontSize="15" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TitleBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding Notes.TogglePinCommand}" ToolTip="{Binding Notes.PinLabel}"
                            AutomationProperties.Name="{Binding Notes.PinLabel}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IslandIconButton}">
                                <Setter Property="Content" Value="&#xE718;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notes.IsPinned}" Value="True">
                                        <Setter Property="Content" Value="&#xE840;" />
                                        <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource IslandIconButton}" Content="&#xE8C8;" Margin="2,0,0,0"
                            Command="{Binding Notes.CopyCommand}" ToolTip="Copy note" AutomationProperties.Name="Copy note" />
                    <Button x:Name="EditorMenuButton" Style="{StaticResource IslandIconButton}" Content="&#xE712;" Margin="2,0,0,0"
                            Click="EditorMenu_Click" ToolTip="More" AutomationProperties.Name="More actions" />
                </StackPanel>
            </Grid>

            <!-- Tags: chips; typing a comma (or Enter) turns the text into a chip right away -->
            <ScrollViewer Grid.Row="1" Margin="2,2,0,0" MaxHeight="52" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <WrapPanel>
                    <ItemsControl ItemsSource="{Binding Notes.EditorTags}" Focusable="False" AutomationProperties.Name="Tags">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CyanSoftBrush}" CornerRadius="10" Height="20"
                                        Padding="8,0,2,0" Margin="0,1,5,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding StringFormat=#{0}}" FontSize="11.5" VerticalAlignment="Center"
                                                   Foreground="{StaticResource CyanBrush}" />
                                        <Button Style="{StaticResource IslandIconButton}" Content="&#xE711;" Width="16" Height="16"
                                                FontSize="7" Margin="3,0,0,0" Foreground="{StaticResource CyanBrush}"
                                                Command="{Binding DataContext.Notes.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Remove tag"
                                                AutomationProperties.Name="{Binding StringFormat=Remove tag {0}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Height="22" MinWidth="120">
                        <TextBox x:Name="TagsBox" Style="{StaticResource IslandInput}" FontSize="12" MinWidth="120"
                                 Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center"
                                 Text="{Binding Notes.TagDraft, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="TagsBox_PreviewKeyDown" LostKeyboardFocus="TagsBox_LostFocus"
                                 AutomationProperties.Name="Add a tag, then type a comma" />
                        <TextBlock Text="# Add tag…" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TagsBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </WrapPanel>
            </ScrollViewer>

            <!-- Toolbar: formatting (applies right away), save state -->
            <Border Grid.Row="2" Margin="0,6,0,6" Padding="3" CornerRadius="10" Background="{StaticResource CardBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolButton}" Content="&#xE8DD;" Click="Bold_Click"
                                ToolTip="Bold  (Ctrl+B)" AutomationProperties.Name="Bold" />
                        <Button Style="{StaticResource ToolButton}" Content="&#xE8DB;" Click="Italic_Click"
                                ToolTip="Italic  (Ctrl+I)" AutomationProperties.Name="Italic" />
                        <Button Style="{StaticResource ToolButton}" Click="Heading_Click"
                                ToolTip="Heading  (type # and a space)" AutomationProperties.Name="Heading"
                                FontFamily="{StaticResource UiFont}" FontWeight="Bold" Content="H" />
                        <Button Style="{StaticResource ToolButton}" Content="&#xE8FD;" Click="Bullet_Click"
                                ToolTip="Bullet list  (type - and a space)" AutomationProperties.Name="Bullet list" />
                        <Button Style="{StaticResource ToolButton}" Content="&#xE73A;" Click="Check_Click"
                                ToolTip="Checklist  (type [] and a space)" AutomationProperties.Name="Checklist" />
                    </StackPanel>
                    <TextBlock Text="{Binding Notes.SaveText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,8,0" FontSize="11" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notes.SaveFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Body: one editor, formatted as you type -->
            <Grid Grid.Row="3" Margin="2,0,0,0">
                <controls:RichNoteEditor x:Name="Editor"
                                         Markdown="{Binding Notes.Content, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource CyanBrush}"
                                         SelectionBrush="{StaticResource CyanBrush}"
                                         AutomationProperties.Name="Note text" />
                <TextBlock Text="Start writing… Try - for a list, [] for a checklist, # for a heading." FontSize="13"
                           VerticalAlignment="Top" TextWrapping="Wrap" Margin="4,1,0,0"
                           Visibility="{Binding IsEmpty, ElementName=Editor, Converter={StaticResource BoolToVisibility}}"
                           Style="{StaticResource Placeholder}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
