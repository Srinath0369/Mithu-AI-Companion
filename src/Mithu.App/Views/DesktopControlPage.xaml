<UserControl x:Class="Mithu.App.Views.DesktopControlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Mithu.App"
             xmlns:controls="clr-namespace:Mithu.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mithu.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignWidth="392" d:DesignHeight="284">

    <!--
        Desktop control (Phase 5.2): the master switch, what Mithu may do, the allowed folders, and "Ask me before
        every action". Everything applies at once.
    -->
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="2,14,0,6" />
        </Style>

        <!-- A switch row: checkbox, title, explanation. -->
        <Style x:Key="OptionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="OptionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="OptionText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ← Desktop control ............ On / Off -->
        <Grid Height="32">
            <Button Style="{StaticResource IslandIconButton}" Content="&#xE72B;" HorizontalAlignment="Left"
                    Command="{Binding GoBackCommand}" ToolTip="Back  (Esc)" AutomationProperties.Name="Back" />
            <TextBlock Text="Desktop control" Margin="38,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource DisplayFont}" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="11" Padding="10,3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DesktopControl.Enabled}" Value="True">
                                <Setter Property="Background" Value="{StaticResource CyanSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding DesktopControl.StateText}" FontSize="11" AutomationProperties.Name="Desktop control status">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DesktopControl.Enabled}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
            </ScrollViewer.Resources>
            <StackPanel Margin="0,0,6,4">

                <!-- Master switch -->
                <Border Style="{StaticResource OptionCard}" BorderBrush="{StaticResource CardRimBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource IslandCheckBox}" VerticalAlignment="Top" Margin="0,2,10,0"
                                  IsChecked="{Binding DesktopControl.Enabled}" AutomationProperties.Name="Let Mithu use apps and files on this PC" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Path=(app:Companion.Name), StringFormat='Let {0} use apps and files on this PC'}" Style="{StaticResource OptionTitle}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource OptionText}"
                                       Text="{Binding Path=(app:Companion.Name), StringFormat='When you ask in the chat, {0} can open apps, folders and files, find files, and set the volume. Every action shows in the chat.'}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- AI needed -->
                <Border CornerRadius="12" Padding="12,9" Margin="0,0,0,6" Background="{StaticResource WarningSoftBrush}"
                        Visibility="{Binding DesktopControl.NeedsAi, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="This works through the chat, so the AI assistant needs to be on." TextWrapping="Wrap"
                                   FontSize="12" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource IslandGhostPillButton}" Content="Set up AI" Height="28" Margin="8,0,0,0"
                                Command="{Binding OpenAiSettingsCommand}" AutomationProperties.Name="Set up AI" />
                    </Grid>
                </Border>

                <!-- What Mithu may do -->
                <StackPanel IsEnabled="{Binding DesktopControl.Enabled}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="{Binding Path=(app:Companion.Name), StringFormat='What {0} may do'}" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource OptionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource IslandCheckBox}" VerticalAlignment="Top" Margin="0,2,10,0"
                                      IsChecked="{Binding DesktopControl.AllowApps}" AutomationProperties.Name="Open apps" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Open apps" Style="{StaticResource OptionTitle}" />
                                <TextBlock Style="{StaticResource OptionText}" Text="Start an app or switch to it, and arrange windows (&quot;VS Code on the left, Chrome on the right&quot;). Closing a window asks first." />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource OptionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource IslandCheckBox}" VerticalAlignment="Top" Margin="0,2,10,0"
                                      IsChecked="{Binding DesktopControl.AllowFiles}" AutomationProperties.Name="Folders and files" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Folders &amp; files" Style="{StaticResource OptionTitle}" />
                                <TextBlock Style="{StaticResource OptionText}" Text="Open, find and organize files: create folders; move, copy and rename (always asks first, with Undo; nothing is replaced or deleted). Only in the folders below; programs and scripts are never opened." />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource OptionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource IslandCheckBox}" VerticalAlignment="Top" Margin="0,2,10,0"
                                      IsChecked="{Binding DesktopControl.AllowSystem}" AutomationProperties.Name="Volume and Settings pages" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Volume &amp; Settings pages" Style="{StaticResource OptionTitle}" />
                                <TextBlock Style="{StaticResource OptionText}" Text="Set or mute the volume, and open a Windows Settings page (Display, Wi-Fi, Bluetooth…) for you to change." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource OptionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource IslandCheckBox}" VerticalAlignment="Top" Margin="0,2,10,0"
                                      IsChecked="{Binding DesktopControl.AllowClipboard}" AutomationProperties.Name="Read what I copy" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Read what I copy" Style="{StaticResource OptionTitle}" />
                                <TextBlock Style="{StaticResource OptionText}" Text="{Binding Path=(app:Companion.Name), StringFormat='When you ask (&quot;summarize what I copied&quot;), {0} reads the copied text and sends it to your AI provider. Copied text can be a password, so turn this off if that worries you.'}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Allowed folders -->                    <Grid Margin="2,14,0,6">
                        <TextBlock Text="Allowed folders" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IslandGhostPillButton}" Content="Reset" Height="26" Padding="10,0" Margin="0,0,6,0"
                                    Command="{Binding DesktopControl.ResetFoldersCommand}" ToolTip="Back to Desktop, Documents, Downloads, Pictures, Music, Videos"
                                    AutomationProperties.Name="Reset folders" />
                            <Button Style="{StaticResource IslandGhostPillButton}" Height="26" Padding="10,0" Margin="0,0,6,0" Click="AddDisk_Click"
                                    ToolTip="Allow a whole disk inside this PC (not C:, which holds Windows)" AutomationProperties.Name="Add disk">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Glyph="&#xEDA2;" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="Add disk" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IslandPillButton}" Height="26" Padding="10,0" Click="AddFolder_Click"
                                    AutomationProperties.Name="Add folder">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Glyph="&#xE710;" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="Add folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="4">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding DesktopControl.Folders}" Focusable="False" AutomationProperties.Name="Allowed folders">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FolderRow}">
                                        <Grid Margin="8,5,2,5" ToolTip="{Binding Path}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:Icon Glyph="&#xE8B7;" FontSize="13" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Path}" FontSize="10.5" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource IslandIconButton}" Content="&#xE711;" Width="26" Height="26" FontSize="9"
                                                    Command="{Binding DataContext.DesktopControl.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Remove" AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Path=(app:Companion.Name), StringFormat='No folders: {0} cannot reach any files.'}" Style="{StaticResource CaptionText}" Margin="10,8"
                                       Visibility="{Binding DesktopControl.HasNoFolders, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- Safety -->
                    <TextBlock Text="Safety" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource OptionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource IslandCheckBox}" VerticalAlignment="Top" Margin="0,2,10,0"
                                      IsChecked="{Binding DesktopControl.AskBeforeEachAction}" AutomationProperties.Name="Ask me before every action" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Ask me before every action" Style="{StaticResource OptionTitle}" />
                                <TextBlock Style="{StaticResource OptionText}" Text="{Binding Path=(app:Companion.Name), StringFormat='{}{0} shows Approve / Cancel in the chat before it opens anything or changes the volume. Searching never asks.'}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" FontSize="11" Margin="2,8,0,0"
                           Text="{Binding Path=(app:Companion.Name), StringFormat='{}{0} never deletes files, runs programs or commands, or changes system settings itself. Moving, copying and renaming files always ask first.'}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
