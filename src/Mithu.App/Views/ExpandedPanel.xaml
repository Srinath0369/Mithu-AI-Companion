<UserControl x:Class="Mithu.App.Views.ExpandedPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Mithu.App"
             xmlns:controls="clr-namespace:Mithu.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Mithu.Core.Models;assembly=Mithu.Core"
             xmlns:vm="clr-namespace:Mithu.App.ViewModels"
             xmlns:local="clr-namespace:Mithu.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignWidth="420" d:DesignHeight="296" Height="296">

    <!--
        Two pages in the same space: Home (input, tiles, up next) and Focus (set up, countdown, finished).
        Switching slides between them; only the visible page takes clicks and keyboard focus.
    -->
    <UserControl.Resources>
        <!-- Focus length chip; the selected one glows cyan. DataContext = FocusChoice. -->
        <Style x:Key="FocusChip" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource MithuFocusVisual}" />
            <Setter Property="Command" Value="{Binding SelectCommand}" />
            <Setter Property="Content" Value="{Binding Label}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CyanSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Small −/+ buttons for rounds and break. -->
        <Style x:Key="StepperButton" TargetType="Button" BasedOn="{StaticResource IslandIconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="StepperValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Rounded box around a stepper ("Rounds − 3 +"). -->
        <Style x:Key="StepperBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardRimBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,3,4,3" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardRimBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <!-- Large pill buttons on the Focus page (Start, Pause, Take 5…). -->
        <Style x:Key="BigPillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CyanOnBrush}" />
            <Setter Property="Background" Value="{StaticResource CyanBrush}" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource MithuFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="19"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BigGhostButton" TargetType="Button" BasedOn="{StaticResource BigPillButton}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="ButtonGlyph" TargetType="controls:Icon">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">

        <!-- ==================================================================== -->
        <!-- ===== Home page ===================================================== -->
        <!-- ==================================================================== -->
        <Grid x:Name="HomePage" Margin="14,0,14,12">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="HomeShift" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- input -->
                <RowDefinition Height="Auto" />  <!-- tiles -->
                <RowDefinition Height="Auto" />  <!-- up next -->
                <RowDefinition Height="*" />     <!-- spacer -->
                <RowDefinition Height="Auto" />  <!-- footer -->
            </Grid.RowDefinitions>

            <!-- ===== Input pill with send button ===== -->
            <Border x:Name="InputPill" Background="{StaticResource InputBrush}" CornerRadius="20"
                    BorderBrush="{StaticResource CardRimBrush}" BorderThickness="1" Padding="14,4,4,4" MinHeight="42">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="InputBox" Style="{StaticResource IslandInput}"
                             Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="64"
                             AutomationProperties.Name="Ask Mithu or write a quick note">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SubmitDraftCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Placeholder -->
                    <TextBlock IsHitTestVisible="False" VerticalAlignment="Center"
                               FontSize="14" Foreground="{StaticResource SubtleTextBrush}" Margin="2,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Text" Value="Jot a note, or “remind me to…”" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAiReady}" Value="True">
                                        <Setter Property="Text" Value="{Binding Path=(app:Companion.Name), StringFormat='Ask {0} anything…'}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                        <!-- Screenshot & ask (what's typed here becomes the question) -->
                        <Button Style="{StaticResource IslandIconButton}" Content="{StaticResource ScreenshotAskIcon}"
                                Width="32" Height="32" Margin="0,0,2,0" Command="{Binding ScreenshotAndAskCommand}"
                                ToolTip="Screenshot &amp; ask: pick an area, a window or the whole screen  (Ctrl+Shift+S)"
                                AutomationProperties.Name="Take a screenshot" />
                        <Button Style="{StaticResource IslandIconButton}" Content="&#xE8BD;" Width="32" Height="32" Margin="0,0,4,0"
                                Command="{Binding OpenAskCommand}" ToolTip="{Binding Path=(app:Companion.Name), StringFormat='Your chats with {0}'}"
                                AutomationProperties.Name="Open chats"
                                Visibility="{Binding IsAiReady, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource IslandPrimaryButton}" Content="&#xE724;"
                                Command="{Binding SubmitDraftCommand}"
                                ToolTip="Send  (Enter · Shift+Enter for a new line)"
                                AutomationProperties.Name="Send" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Feature tiles ===== -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,0">
                <Button Style="{StaticResource FeatureTile}" Margin="0,0,4,0"
                        Command="{Binding OpenRemindersCommand}"
                        AutomationProperties.Name="Reminders">
                    <Grid>
                        <controls:Icon Glyph="&#xEA8F;" Style="{StaticResource IconGlyph}" VerticalAlignment="Top" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                Visibility="{Binding Reminders.HasTileBadge, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Reminders.TileBadgeIsDue}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Reminders.TileBadge}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PillText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Reminders.TileBadgeIsDue}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="Reminders" VerticalAlignment="Bottom" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource FeatureTile}" Margin="4,0,4,0"
                        Command="{Binding OpenTodosCommand}"
                        AutomationProperties.Name="To-do">
                    <Grid>
                        <controls:Icon Glyph="&#xE9D5;" Style="{StaticResource IconGlyph}" VerticalAlignment="Top" />
                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Visibility="{Binding Todos.HasOpenAnywhere, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding Todos.OpenCount}" Style="{StaticResource PillText}" Typography.NumeralAlignment="Tabular" />
                        </Border>
                        <TextBlock Text="To-do" VerticalAlignment="Bottom" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource FeatureTile}" Margin="4,0,4,0"
                        Command="{Binding OpenNotesCommand}"
                        AutomationProperties.Name="Notes">
                    <Grid>
                        <controls:Icon Glyph="&#xE70B;" Style="{StaticResource IconGlyph}" VerticalAlignment="Top" />
                        <TextBlock Text="Notes" VerticalAlignment="Bottom" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource FeatureTile}" Margin="4,0,0,0"
                        Command="{Binding OpenFocusCommand}"
                        AutomationProperties.Name="Focus timer">
                    <Grid>
                        <controls:Icon Glyph="&#xE916;" Style="{StaticResource IconGlyph}" VerticalAlignment="Top" />
                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Visibility="{Binding Focus.HasTileBadge, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Focus.TileBadge}" Style="{StaticResource PillText}"
                                       Typography.NumeralAlignment="Tabular" />
                        </Border>
                        <TextBlock Text="Focus" VerticalAlignment="Bottom" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                    </Grid>
                </Button>
            </UniformGrid>

            <!-- ===== Up next: the most pressing reminder (click → Reminders) ===== -->
            <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource PanelCard}" Cursor="Hand"
                    AutomationProperties.Name="Up next">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenRemindersCommand}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource CyanSoftBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Reminders.UpNextIsOverdue}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <controls:Icon Glyph="&#xE787;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:Icon.Style>
                                <Style TargetType="controls:Icon" BasedOn="{StaticResource IconGlyph}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Reminders.UpNextIsOverdue}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:Icon.Style>
                        </controls:Icon>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Up next" Style="{StaticResource CaptionText}" />
                        <TextBlock controls:EmojiText.Text="{Binding Reminders.UpNextTitle}" Foreground="{StaticResource TextBrush}"
                                   FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding Reminders.UpNextWhen}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Reminders.HasUpNext, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Reminders.UpNextIsOverdue}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Claude Code at work (⋯ → Claude Code): its sessions, live ===== -->
            <Border Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource PanelCard}" VerticalAlignment="Top"
                    AutomationProperties.Name="Claude Code"
                    Visibility="{Binding ClaudeCode.HasSessions, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                <ItemsControl ItemsSource="{Binding ClaudeCode.Sessions}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ClaudeSessionRow}">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:Icon FontSize="12" VerticalAlignment="Center" Margin="2,0,10,0" RenderTransformOrigin="0.5,0.5">
                                    <controls:Icon.RenderTransform>
                                        <RotateTransform />
                                    </controls:Icon.RenderTransform>
                                    <controls:Icon.Style>
                                        <Style TargetType="controls:Icon">
                                            <Setter Property="Glyph" Value="&#xE73E;" />
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNeedsYou}" Value="True">
                                                    <Setter Property="Glyph" Value="&#xE9CE;" />
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Glyph" Value="&#xF16A;" />
                                                    <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="ClaudeSpin">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0" To="360" Duration="0:0:1.1" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="ClaudeSpin" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:Icon.Style>
                                </controls:Icon>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}">
                                        <Run Text="Claude Code · " Foreground="{StaticResource SubtleTextBrush}" /><Run Text="{Binding Project, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Activity}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNeedsYou}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Elapsed}" Style="{StaticResource CaptionText}" FontSize="11" Typography.NumeralAlignment="Tabular"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- ===== Footer: shortcut hint ===== -->
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Center"
                        ToolTip="{Binding Path=(app:Companion.Name), StringFormat='Show or hide {0} from anywhere'}">
                    <TextBlock Text="{Binding HotkeyText}" Style="{StaticResource PillText}" />
                </Border>
            </Grid>
        </Grid>

        <!-- ==================================================================== -->
        <!-- ===== Focus page ==================================================== -->
        <!-- ==================================================================== -->
        <Grid x:Name="FocusPage" Margin="14,0,14,12" Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="FocusShift" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- back + title -->
                <RowDefinition Height="*" />     <!-- content -->
            </Grid.RowDefinitions>

            <!-- ===== Navigation: ← Focus ===== -->
            <Grid Height="32">
                <Button Style="{StaticResource IslandIconButton}" Content="&#xE72B;" HorizontalAlignment="Left"
                        Command="{Binding GoBackCommand}" ToolTip="Back  (Esc)"
                        AutomationProperties.Name="Back" />
                <TextBlock Text="Focus" Margin="38,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource DisplayFont}" />
            </Grid>

            <Grid Grid.Row="1">

                <!-- ===== Set up: intention, length, rounds, break, Start ===== -->
                <StackPanel x:Name="SetupView" Margin="0,8,0,0"
                            Visibility="{Binding Focus.Card, Converter={StaticResource ShowWhen}, ConverterParameter=Setup}">
                    <Border Background="{StaticResource InputBrush}" CornerRadius="20" Height="40" Padding="16,0"
                            BorderBrush="{StaticResource CardRimBrush}" BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="IntentionBox" Style="{StaticResource IslandInput}" FontSize="14"
                                     Text="{Binding Focus.IntentionDraft, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="80"
                                     AutomationProperties.Name="What are you focusing on? Optional">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding Focus.StartCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="What are you focusing on? (optional)" IsHitTestVisible="False"
                                       VerticalAlignment="Center" FontSize="14" Margin="2,0,0,0"
                                       Foreground="{StaticResource SubtleTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=IntentionBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Length: presets, or Custom (becomes a minutes box) -->
                    <TextBlock Text="Length" Style="{StaticResource CaptionText}" Margin="4,12,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding Focus.Choices}" Focusable="False"
                                      AutomationProperties.Name="Focus length">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FocusChip}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource FocusChip}" DataContext="{Binding Focus.CustomChoice}"
                                Visibility="{Binding DataContext.Focus.IsCustom, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource HideWhen}, ConverterParameter=True}" />
                        <Border Height="28" CornerRadius="14" Padding="11,0" BorderThickness="1"
                                Background="{StaticResource CyanSoftBrush}"
                                Visibility="{Binding Focus.IsCustom, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Focus.IsCustomInvalid}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="CustomMinutesBox" Style="{StaticResource IslandInput}" FontSize="12"
                                         MinWidth="10" MaxLength="3" TextAlignment="Right"
                                         Foreground="{StaticResource CyanBrush}"
                                         Text="{Binding Focus.CustomMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Any length from 1 to 180 minutes"
                                         AutomationProperties.Name="Custom focus length in minutes, 1 to 180">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding Focus.StartCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="min" FontSize="12" Foreground="{StaticResource CyanBrush}"
                                           VerticalAlignment="Center" Margin="3,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Rounds and break -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource StepperBox}">
                            <Grid>
                                <TextBlock Text="Rounds" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource StepperButton}" Content="&#xE738;"
                                            Command="{Binding Focus.FewerRoundsCommand}" AutomationProperties.Name="Fewer rounds" />
                                    <TextBlock Text="{Binding Focus.PlannedRounds}" Style="{StaticResource StepperValue}"
                                               MinWidth="22" AutomationProperties.Name="Rounds" />
                                    <Button Style="{StaticResource StepperButton}" Content="&#xE710;"
                                            Command="{Binding Focus.MoreRoundsCommand}" AutomationProperties.Name="More rounds" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource StepperBox}"
                                IsEnabled="{Binding Focus.CanChooseBreak}" ToolTip="Break between rounds">
                            <Grid>
                                <TextBlock Text="Break" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource StepperButton}" Content="&#xE738;"
                                            Command="{Binding Focus.ShorterBreakCommand}" AutomationProperties.Name="Shorter break" />
                                    <TextBlock Text="{Binding Focus.BreakText}" Style="{StaticResource StepperValue}"
                                               MinWidth="46" AutomationProperties.Name="Break length" />
                                    <Button Style="{StaticResource StepperButton}" Content="&#xE710;"
                                            Command="{Binding Focus.LongerBreakCommand}" AutomationProperties.Name="Longer break" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Button Style="{StaticResource BigPillButton}" Margin="0,16,0,0"
                            Command="{Binding Focus.StartCommand}" AutomationProperties.Name="Start focus">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Glyph="&#xE768;" Style="{StaticResource ButtonGlyph}" />
                            <TextBlock Text="{Binding Focus.StartText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ===== Countdown: ring with time, title, pause / stop ===== -->
                <StackPanel VerticalAlignment="Center"
                            Visibility="{Binding Focus.Card, Converter={StaticResource ShowWhen}, ConverterParameter=Countdown}">
                    <Grid Width="140" Height="140" HorizontalAlignment="Center">
                        <Ellipse Stroke="{StaticResource CardHoverBrush}" StrokeThickness="8" />
                        <Ellipse Stroke="{StaticResource CyanBrush}" StrokeThickness="8" StrokeDashCap="Round"
                                 StrokeDashArray="{Binding Focus.Progress, Converter={StaticResource RingDash}, ConverterParameter='140,8'}"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Focus.RemainingText}" HorizontalAlignment="Center"
                                       FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                                       Foreground="{StaticResource TextBrush}" Typography.NumeralAlignment="Tabular"
                                       AutomationProperties.Name="Time left" />
                            <TextBlock Text="{Binding Focus.RingCaption}" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Center" Margin="0,-2,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Focus.Title}" HorizontalAlignment="Center" Margin="0,12,0,0" MaxWidth="360"
                               FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Focus.Detail}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"
                               Margin="0,2,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button Style="{StaticResource BigPillButton}" MinWidth="118"
                                Command="{Binding Focus.PauseResumeCommand}"
                                AutomationProperties.Name="{Binding Focus.PauseLabel}">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Glyph="{Binding Focus.PauseGlyph}" Style="{StaticResource ButtonGlyph}" />
                                <TextBlock Text="{Binding Focus.PauseLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BigGhostButton}" Margin="10,0,0,0" MinWidth="96"
                                Command="{Binding Focus.StopCommand}" AutomationProperties.Name="Stop">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Glyph="&#xE71A;" Style="{StaticResource ButtonGlyph}" />
                                <TextBlock Text="Stop" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- ===== Finished: check mark, summary, next step (nothing starts by itself) ===== -->
                <StackPanel VerticalAlignment="Center"
                            Visibility="{Binding Focus.Card, Converter={StaticResource ShowWhen}, ConverterParameter=Finished}">
                    <Grid Width="96" Height="96" HorizontalAlignment="Center">
                        <Ellipse Fill="{StaticResource CyanSoftBrush}" />
                        <Ellipse Stroke="{StaticResource CyanBrush}" StrokeThickness="3" Opacity="0.6" />
                        <controls:Icon Glyph="&#xE73E;" FontSize="36"
                                   Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding Focus.Title}" HorizontalAlignment="Center" Margin="0,14,0,0" MaxWidth="360"
                               FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               FontFamily="{StaticResource DisplayFont}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Focus.Detail}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"
                               Margin="0,3,0,0" MaxWidth="360" TextTrimming="CharacterEllipsis" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Style="{StaticResource BigGhostButton}" Content="End" Margin="0,0,8,0"
                                Command="{Binding Focus.EndSessionCommand}" ToolTip="End this session"
                                AutomationProperties.Name="End session"
                                Visibility="{Binding Focus.CanEndSession, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource BigGhostButton}" Content="{Binding Focus.SecondaryText}" Margin="0,0,8,0"
                                Command="{Binding Focus.SecondaryCommand}"
                                AutomationProperties.Name="{Binding Focus.SecondaryText}"
                                Visibility="{Binding Focus.HasSecondary, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource BigPillButton}" Content="{Binding Focus.PrimaryText}" MinWidth="110"
                                Command="{Binding Focus.PrimaryCommand}"
                                AutomationProperties.Name="{Binding Focus.PrimaryText}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ==================================================================== -->
        <!-- ===== Notes page ==================================================== -->
        <!-- ==================================================================== -->
        <local:NotesPage x:Name="NotesView" Margin="14,0,14,12" Visibility="Collapsed" />

        <!-- ==================================================================== -->
        <!-- ===== Reminders page ================================================ -->
        <!-- ==================================================================== -->
        <local:RemindersPage x:Name="RemindersView" Margin="14,0,14,12" Visibility="Collapsed" />

        <!-- ==================================================================== -->
        <!-- ===== AI settings page ============================================== -->
        <!-- ==================================================================== -->
        <local:AiSettingsPage x:Name="AiSettingsView" Margin="14,0,14,12" Visibility="Collapsed" />
        <local:DesktopControlPage x:Name="DesktopControlView" Margin="14,0,14,12" Visibility="Collapsed" />
        <local:TodoPage x:Name="TodoView" Margin="14,0,14,12" Visibility="Collapsed" />
        <local:SetupPage x:Name="FirstRunView" Margin="14,0,14,12" Visibility="Collapsed" />

        <!-- ==================================================================== -->
        <!-- ===== Ask (AI chat) page ============================================ -->
        <!-- ==================================================================== -->
        <local:AskPage x:Name="AskView" Margin="14,0,14,12" Visibility="Collapsed" />
    </Grid>
</UserControl>
