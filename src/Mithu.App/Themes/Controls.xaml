<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Mithu.App.Converters"
                    xmlns:controls="clr-namespace:Mithu.App.Controls">

    <!--
        Production control styles for the island: round icon buttons, primary send button,
        feature tiles, input, and dark menus/tooltips (also used by the tray menu).
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />

    <!-- Visibility helpers: ShowWhen/HideWhen compare the bound value's text to ConverterParameter. -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:ShowWhenConverter x:Key="ShowWhen" />
    <conv:ShowWhenConverter x:Key="HideWhen" Invert="True" />
    <conv:RingDashConverter x:Key="RingDash" />
    <conv:PillDashConverter x:Key="PillDash" />

    <!-- Every list and text area: 24 px per wheel notch, eased (WPF's ~48 px jumps half the panel). -->
    <Style TargetType="ScrollViewer">
        <Setter Property="controls:WheelScroll.Step" Value="24" />
    </Style>

    <!--
        ===== Slim dark scrollbar =====
        For lists that should show they scroll (e.g. the model picker): a 4 px rounded thumb on a clear track,
        no arrow buttons; it widens a little on hover. Apply with ScrollViewer.Resources → BasedOn this style.
    -->
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Width="4" CornerRadius="2" HorizontalAlignment="Center"
                                                    Background="#3DFFFFFF" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Width" Value="6" />
                                                    <Setter TargetName="Bar" Property="Background" Value="#66FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bar" Property="Width" Value="6" />
                                                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource CyanBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Round icon button (▲ ▼ ⚙) ===== -->
    <!-- Icon codes (Content="&#xE72B;") in icon buttons are drawn as vector icons (Controls/Icon). -->
    <controls:GlyphTemplateSelector x:Key="GlyphContent" />

    <Style x:Key="IslandIconButton" TargetType="ButtonBase">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ContentTemplateSelector" Value="{StaticResource GlyphContent}" />
        <!-- Kept for the rare code without a vector shape (drawn from the font). -->
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MithuFocusVisual}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="500" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="15"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardPressedBrush}" />
                            <Setter TargetName="Bg" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.92" ScaleY="0.92" /></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        "Screenshot & ask" icon (vector): selection corners with an AI sparkle inside. Takes the colour of the button
        it sits in. x:Shared="False": each button gets its own copy.
    -->
    <Viewbox x:Key="ScreenshotAskIcon" x:Shared="False" Width="17" Height="17">
        <Canvas Width="20" Height="20">
            <Path StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                  Data="M2,7 V4.5 A2.5,2.5 0 0 1 4.5,2 H7 M13,2 H15.5 A2.5,2.5 0 0 1 18,4.5 V7 M18,13 V15.5 A2.5,2.5 0 0 1 15.5,18 H13 M7,18 H4.5 A2.5,2.5 0 0 1 2,15.5 V13" />
            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                  Data="M10,5.2 C10.45,8 12,9.55 14.8,10 C12,10.45 10.45,12 10,14.8 C9.55,12 8,10.45 5.2,10 C8,9.55 9.55,8 10,5.2 Z" />
        </Canvas>
    </Viewbox>

    <!-- ===== Primary round send button (cyan) ===== -->
    <Style x:Key="IslandPrimaryButton" TargetType="Button" BasedOn="{StaticResource IslandIconButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource CyanOnBrush}" />
        <Setter Property="Background" Value="{StaticResource CyanBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="16"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.92" ScaleY="0.92" /></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text pill button (cyan): "Start", "Take 5" ===== -->
    <Style x:Key="IslandPillButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource CyanOnBrush}" />
        <Setter Property="Background" Value="{StaticResource CyanBrush}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MithuFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="14"
                            Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95" /></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet sibling of the pill: "Skip", "Later". -->
    <Style x:Key="IslandGhostPillButton" TargetType="Button" BasedOn="{StaticResource IslandPillButton}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- ===== Feature tile (Reminders / Notes / Focus) ===== -->
    <Style x:Key="FeatureTile" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardRimBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="64" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MithuFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="10,8" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small pill: "Soon", shortcut hints. -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="5,1" />
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>

    <!-- A feature icon (tiles): vector, cyan. -->
    <Style x:Key="IconGlyph" TargetType="controls:Icon">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
    </Style>

    <!-- ===== Input (rounded, borderless) ===== -->
    <Style x:Key="IslandInput" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Dark menus (in-app ⚙ menu and tray menu) ===== -->
    <Style x:Key="IslandMenu" TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource MenuSurfaceBrush}" BorderBrush="{StaticResource IslandRimBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,8,8" MinWidth="220">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IslandMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="8,6" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:Icon x:Name="Check" Glyph="&#xE73E;"
                                           FontSize="11" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center"
                                           Visibility="Hidden" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,0,0,0"
                                           Foreground="{StaticResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                <!-- A submenu: chevron on the right. -->
                                <controls:Icon x:Name="Arrow" Grid.Column="3" Glyph="&#xE76C;" FontSize="10" Margin="12,0,0,0"
                                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <!-- Its items open to the side, in the same dark card as the menu. -->
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="0" VerticalOffset="-6"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{StaticResource MenuSurfaceBrush}" BorderBrush="{StaticResource IslandRimBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,8,8" MinWidth="200">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black" />
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource MenuHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource MenuHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                            <Setter TargetName="Check" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IslandMenuSeparator" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="8,4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section caption inside a menu. -->
    <Style x:Key="IslandMenuHeader" TargetType="MenuItem" BasedOn="{StaticResource IslandMenuItem}">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Small rounded checkbox for checklists (cyan when ticked). -->
    <Style x:Key="IslandCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MithuFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Width="15" Height="15" CornerRadius="4" BorderThickness="1.5"
                            BorderBrush="{StaticResource MutedBrush}" Background="Transparent">
                        <controls:Icon x:Name="Tick" Glyph="&#xE73E;"
                                   FontSize="9" Foreground="{StaticResource CyanOnBrush}" Visibility="Hidden"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource CyanBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark tooltips everywhere in the app. -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="True" />
        <!-- Tooltips inherit the font of their button; icon buttons use an icon font, which has no letters
             (text would show as boxes). Always use the text font. -->
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource MenuSurfaceBrush}" BorderBrush="{StaticResource IslandRimBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.4" Color="Black" />
                        </Border.Effect>
                        <ContentPresenter TextElement.Foreground="{StaticResource TextBrush}"
                                          TextElement.FontSize="12" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
