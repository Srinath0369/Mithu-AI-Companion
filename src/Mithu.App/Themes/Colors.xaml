<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Brand palette (blueprint §2). Brushes are frozen: cheaper to render, thread-safe. -->
    <Color x:Key="MidnightColor">#0A0E16</Color>
    <Color x:Key="PanelColor">#1B2330</Color>
    <Color x:Key="ElevatedColor">#273244</Color>
    <Color x:Key="CyanColor">#2DF3F3</Color>
    <Color x:Key="TextColor">#F4F8FC</Color>
    <Color x:Key="MutedColor">#A7B5C7</Color>
    <Color x:Key="SuccessColor">#68E7B1</Color>
    <Color x:Key="WarningColor">#F6C76E</Color>
    <!-- Urgent reminders (same red as Mithu's angry rim). -->
    <Color x:Key="UrgentColor">#FF6B5A</Color>

    <SolidColorBrush x:Key="MidnightBrush" Color="{StaticResource MidnightColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="UrgentBrush" Color="{StaticResource UrgentColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#26F6C76E" po:Freeze="True" />
    <SolidColorBrush x:Key="UrgentSoftBrush" Color="#2EFF6B5A" po:Freeze="True" />

    <!-- ===== Island surface (production design) ===== -->
    <!-- Near-black glass with a faint cool tint; reads as a hardware notch when docked. -->
    <LinearGradientBrush x:Key="IslandSurfaceBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FF0B0F17" Offset="0" />
        <GradientStop Color="#FF121925" Offset="1" />
    </LinearGradientBrush>
    <!-- Hairline rim: subtle so it never looks like a "window border". -->
    <SolidColorBrush x:Key="IslandRimBrush" Color="#2EFFFFFF" po:Freeze="True" />
    <!-- Cards inside the panel. -->
    <SolidColorBrush x:Key="CardBrush" Color="#0FFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1CFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="CardPressedBrush" Color="#10FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="CardRimBrush" Color="#14FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="InputBrush" Color="#14FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7A8F" po:Freeze="True" />
    <SolidColorBrush x:Key="CyanSoftBrush" Color="#262DF3F3" po:Freeze="True" />
    <SolidColorBrush x:Key="CyanOnBrush" Color="#06212A" po:Freeze="True" />
    <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF" po:Freeze="True" />

    <!-- Menus / tooltips (shared by in-app options menu and tray menu). -->
    <SolidColorBrush x:Key="MenuSurfaceBrush" Color="#FF151C28" po:Freeze="True" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#FF222C3B" po:Freeze="True" />

</ResourceDictionary>
