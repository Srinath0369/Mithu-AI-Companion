<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(MithuWindowsTfm)</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- For the few tests of the note editor's document conversion (WPF types, run on an STA thread). -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- UseWPF drops the implicit System.IO import. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mithu.Core\Mithu.Core.csproj" />
    <ProjectReference Include="..\..\src\Mithu.Infrastructure\Mithu.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Mithu.App\Mithu.App.csproj" />
  </ItemGroup>

</Project>