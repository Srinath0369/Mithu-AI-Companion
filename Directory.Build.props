<Project>
  <!-- Shared settings for every project in the solution. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Company>Mithu</Company>
    <Product>Mithu</Product>
    <Version>1.0.0</Version>
    <Copyright>Copyright (c) 2026 Srinath. MIT License.</Copyright>
    <!-- Windows 10 2004+ (19041) unlocks WinRT APIs such as scheduled toast notifications. -->
    <MithuWindowsTfm>net10.0-windows10.0.19041.0</MithuWindowsTfm>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
